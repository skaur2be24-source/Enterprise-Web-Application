
import java.io.*;
import java.util.*;

// EXPERIMENT 1: FILE HANDLING

class Experiment1 {

    public static void main() {

        // Writing student details using FileWriter
        try {
            FileWriter fw = new FileWriter("students.txt");

            fw.write("101, Rahul, BCA\n");
            fw.write("102, Aman, BCA\n");
            fw.write("103, Ravi, MCA\n");

            fw.close();

            System.out.println("Student records saved successfully.");

        } catch (IOException e) {
            System.out.println("Error writing file: " + e);
        }

        // Reading student details using FileReader
        try {
            FileReader fr = new FileReader("students.txt");

            int ch;

            System.out.println("\nStudent Records:");

            while ((ch = fr.read()) != -1) {
                System.out.print((char) ch);
            }

            fr.close();

        } catch (IOException e) {
            System.out.println("Error reading file: " + e);
        }

        // Copying binary file using byte streams
        try {
            FileInputStream fin =
                    new FileInputStream("input.dat");

            FileOutputStream fout =
                    new FileOutputStream("copy.dat");

            int data;

            while ((data = fin.read()) != -1) {
                fout.write(data);
            }

            fin.close();
            fout.close();

            System.out.println("\nBinary file copied successfully.");

        } catch (IOException e) {
            System.out.println(
                    "Binary file error: " + e.getMessage());
        }
    }
}


// EXPERIMENT 2: FILE BASED LOG ANALYZER

class Experiment2 {

    public static void main() {

        int count = 0;

        try {
            BufferedReader br =
                    new BufferedReader(
                            new FileReader("app.log"));

            BufferedWriter bw =
                    new BufferedWriter(
                            new FileWriter("filtered.log"));

            String line;

            while ((line = br.readLine()) != null) {

                count++;

                System.out.println(line);

                // Find ERROR and WARNING messages
                if (line.contains("ERROR") ||
                        line.contains("WARNING")) {

                    bw.write(line);
                    bw.newLine();
                }
            }

            br.close();
            bw.close();

            System.out.println("\nTotal Log Entries: " + count);

            System.out.println(
                    "Filtered logs saved in filtered.log");

        } catch (IOException e) {
            System.out.println("File error: " + e.getMessage());
        }
    }
}

// EXPERIMENT 3: SERIALIZATION AND DESERIALIZATION

class Experiment3 {

    // Employee class
    static class Employee implements Serializable {

        int id;
        String name;
        String department;
        double salary;

        Employee(int id, String name,
                 String department, double salary) {

            this.id = id;
            this.name = name;
            this.department = department;
            this.salary = salary;
        }

        void display() {

            System.out.println("ID: " + id);
            System.out.println("Name: " + name);
            System.out.println("Department: " + department);
            System.out.println("Salary: " + salary);

            System.out.println("-------------------");
        }
    }

    public static void main() {

        // Creating employee objects
        ArrayList<Employee> list = new ArrayList<>();

        list.add(new Employee(101, "Rahul", "IT", 30000));
        list.add(new Employee(102, "Aman", "HR", 25000));
        list.add(new Employee(103, "Ravi", "Sales", 28000));

        // Serialization
        try {
            ObjectOutputStream out =
                    new ObjectOutputStream(
                            new FileOutputStream("employee.dat"));

            out.writeObject(list);

            out.close();

            System.out.println(
                    "Employee records saved successfully.");

        } catch (IOException e) {
            System.out.println("Error: " + e);
        }

        // Deserialization
        try {
            ObjectInputStream in =
                    new ObjectInputStream(
                            new FileInputStream("employee.dat"));

            ArrayList<Employee> employees =
                    (ArrayList<Employee>) in.readObject();

            in.close();

            System.out.println("\nEmployee Records:");

            for (Employee emp : employees) {
                emp.display();
            }

        } catch (IOException | ClassNotFoundException e) {
            System.out.println("Error: " + e);
        }
    }
}

