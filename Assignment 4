
import java.util.*;

class Course {
    String courseCode;
    int capacity;

    HashSet<String> enrolledStudents;
    ArrayList<String> prerequisites;
    LinkedList<String> waitlist;

    Course(String courseCode, int capacity,
           ArrayList<String> prerequisites) {

        this.courseCode = courseCode;
        this.capacity = capacity;

        enrolledStudents = new HashSet<>();
        this.prerequisites = prerequisites;
        waitlist = new LinkedList<>();
    }
}

class CourseRegistration {

    HashMap<String, Course> courses = new HashMap<>();

    // Add a course
    void addCourse(String code, int capacity,
                   ArrayList<String> prerequisites) {

        courses.put(code,
            new Course(code, capacity, prerequisites));

        System.out.println("Course added: " + code);
    }

    // Register a student
    void registerStudent(String code, String studentId,
                         Set<String> completedCourses) {

        Course c = courses.get(code);

        if (c == null) {
            System.out.println("Course not found!");
            return;
        }

        if (c.enrolledStudents.contains(studentId)
                || c.waitlist.contains(studentId)) {
            System.out.println("Student already registered!");
            return;
        }

        // Check prerequisites
        if (!completedCourses.containsAll(c.prerequisites)) {
            System.out.println("Prerequisites not completed!");
            return;
        }

        // Check course capacity
        if (c.enrolledStudents.size() < c.capacity) {

            c.enrolledStudents.add(studentId);

            System.out.println(studentId +
                    " successfully enrolled in " + code);

        } else {

            c.waitlist.addLast(studentId);

            System.out.println(studentId +
                    " added to waitlist for " + code);
        }
    }

    // Drop a student and promote waitlisted student
    void dropStudent(String code, String studentId) {

        Course c = courses.get(code);

        if (c == null) {
            System.out.println("Course not found!");
            return;
        }

        if (!c.enrolledStudents.remove(studentId)) {
            System.out.println("Student not enrolled!");
            return;
        }

        System.out.println(studentId + " dropped from " + code);

        // Automatically promote next eligible student
        while (!c.waitlist.isEmpty()) {

            String nextStudent = c.waitlist.removeFirst();

            // Promotion assumes prerequisites were verified
            // when the student originally joined the waitlist.
            c.enrolledStudents.add(nextStudent);

            System.out.println(nextStudent +
                    " promoted from waitlist!");

            break;
        }
    }

    // Display course details
    void displayCourse(String code) {

        Course c = courses.get(code);

        if (c == null) {
            System.out.println("Course not found!");
            return;
        }

        System.out.println("\nCourse Code: " + c.courseCode);
        System.out.println("Capacity: " + c.capacity);
        System.out.println("Enrolled Students: " +
                c.enrolledStudents);
        System.out.println("Prerequisites: " +
                c.prerequisites);
        System.out.println("Waitlist: " + c.waitlist);
    }
}

public class CourseRegistrationDemo {

    public static void main(String[] args) {

        CourseRegistration cr = new CourseRegistration();

        cr.addCourse("JAVA101", 2,
                new ArrayList<>(Arrays.asList("CS101")));

        cr.addCourse("WEB201", 2,
                new ArrayList<>(Arrays.asList("JAVA101")));

        Set<String> completed =
                new HashSet<>(Arrays.asList("CS101"));

        cr.registerStudent("JAVA101", "S101", completed);
        cr.registerStudent("JAVA101", "S102", completed);
        cr.registerStudent("JAVA101", "S103", completed);

        cr.displayCourse("JAVA101");

        System.out.println("\nDropping student S101:");

        cr.dropStudent("JAVA101", "S101");

        cr.displayCourse("JAVA101");
    }
}
