import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        
        Scanner sc = new Scanner(System.in);
        
        System.out.print("Enter a number: ");
        int n = sc.nextInt();
        
        int count = 0;
        int num = Math.abs(n);
        
        if (num == 0){
            count = 1;
        }
        else{
            while(num != 0){
                count++;
                num = num/10;
            }
        }
        
        System.out.println("Number of digits = " + count);
        
        sc.close();
    }
}
