
import java.util.Scanner;

// Interface
interface Printable {
    void printDetails();
}

// Abstract class
abstract class LibraryResource {
    private int resourceId;
    private String title;
    private String author;
    protected static String libraryName = "Smart Library";
    private static int totalResources = 0;

    public LibraryResource(int id, String title, String author) {
        this.resourceId = id;
        this.title = title;
        this.author = author;
        totalResources++;
    }

    public int getResourceId() {
        return resourceId;
    }

    public String getTitle() {
        return title;
    }

    public String getAuthor() {
        return author;
    }

    public abstract double calculateFine(int overdueDays);

    public static void displayTotalResources() {
        System.out.println("Total Resources: " + totalResources);
    }

    public void displayDetails() {
        System.out.println("Resource ID: " + resourceId);
        System.out.println("Title: " + title);
        System.out.println("Author: " + author);
    }
}

// Book class
class Book extends LibraryResource implements Printable {
    public Book(int id, String title, String author) {
        super(id, title, author);
    }

    public double calculateFine(int overdueDays) {
        return overdueDays * 5;
    }

    public void printDetails() {
        System.out.println("Type: Book");
        System.out.println("Fine Rate: Rs.5/day");
    }
}

// Digital Resource class
class DigitalResource extends LibraryResource implements Printable {
    public DigitalResource(int id, String title, String author) {
        super(id, title, author);
    }

    public double calculateFine(int overdueDays) {
        return overdueDays * 2;
    }

    public void printDetails() {
        System.out.println("Type: Digital Resource");
        System.out.println("Fine Rate: Rs.2/day");
    }
}

// Utility class
class InputValidator {
    public static boolean validateResourceId(int id) {
        return id > 0;
    }

    public static boolean validateFineDays(int days) {
        return days >= 0;
    }

    public static boolean validateText(String text) {
        return text != null && !text.trim().isEmpty();
    }
}

// Main class
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        LibraryResource[] resources = new LibraryResource[5];
        int count = 0;

        System.out.println("SMART LIBRARY RESOURCE MANAGEMENT");

        while (count < 5) {
            System.out.println("\nEnter Resource " + (count + 1));

            System.out.print("Resource ID: ");
            int id = sc.nextInt();
            sc.nextLine();

            System.out.print("Title: ");
            String title = sc.nextLine();

            System.out.print("Author: ");
            String author = sc.nextLine();

            System.out.print("Type (1-Book, 2-Digital): ");
            int type = sc.nextInt();

            if (!InputValidator.validateResourceId(id) ||
                !InputValidator.validateText(title) ||
                !InputValidator.validateText(author) ||
                (type != 1 && type != 2)) {

                System.out.println("Invalid input. Try again.");
                continue;
            }

            if (type == 1)
                resources[count] = new Book(id, title, author);
            else
                resources[count] = new DigitalResource(id, title, author);

            count++;
            System.out.println("Resource created successfully.");
        }

        double totalFine = 0;

        System.out.println("\n===== ALL RESOURCES =====");

        for (LibraryResource resource : resources) {
            System.out.println("\nEnter overdue days for Resource ID "
                    + resource.getResourceId() + ":");

            int days = sc.nextInt();

            if (!InputValidator.validateFineDays(days)) {
                System.out.println("Invalid overdue days.");
                continue;
            }

            resource.displayDetails();
            ((Printable) resource).printDetails();

            double fine = resource.calculateFine(days);
            System.out.println("Overdue Days: " + days);
            System.out.println("Fine: Rs." + fine);

            totalFine += fine;
        }

        LibraryResource.displayTotalResources();
        System.out.println("\nTotal Fine of All Resources: Rs." + totalFine);

        sc.close();
    }
}
